generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AppointmentSlotStatus {
  AVAILABLE
  BOOKED
  UNAVAILABLE
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
}

model Doctor {
  id        Int    @id @default(autoincrement())
  name      String
  specialty String

  slots AppointmentSlot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Patient {
  id    Int    @id @default(autoincrement())
  name  String
  email String @unique

  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AppointmentSlot {
  id Int @id @default(autoincrement())

  doctorId Int
  doctor   Doctor @relation(fields: [doctorId], references: [id])

  startTime DateTime
  endTime   DateTime

  status AppointmentSlotStatus @default(AVAILABLE)

  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([doctorId, startTime, endTime])
  @@index([doctorId, status])
}

model Booking {
  id Int @id @default(autoincrement())

  slotId Int
  slot   AppointmentSlot @relation(fields: [slotId], references: [id])

  patientId Int
  patient   Patient @relation(fields: [patientId], references: [id])

  status BookingStatus @default(CONFIRMED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slotId])
  @@index([patientId])
  @@index([status])
}
